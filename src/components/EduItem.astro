---
import type { EducationEntry } from "../data/types";

interface Props {
  entry: EducationEntry;
}
const { entry } = Astro.props;
const cls = entry.placeholder ? "placeholder" : "";
---

<div class="edu-item">
  <div class="edu-left">
    <h3 class:list={[cls]}>{entry.degree}</h3>
    <p class:list={["edu-inst", cls]}>{entry.institution}</p>
    {entry.description && <p class:list={[cls]}>{entry.description}</p>}
  </div>
  <span class:list={["t-date", cls]}>{entry.dateRange}</span>
</div>
